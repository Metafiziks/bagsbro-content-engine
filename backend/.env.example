# ============================================
# Blockchain Ballers - Backend Environment
# ============================================

# Server
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# Database (PostgreSQL)
# Local: postgresql://postgres:password@localhost:5432/blockchain_ballers
# Cloud SQL: postgresql://user:password@/blockchain_ballers?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL="postgresql://postgres:password@localhost:5432/blockchain_ballers"

# Redis
# Local: redis://localhost:6379
# Memorystore: redis://INTERNAL_IP:6379
REDIS_URL="redis://localhost:6379"

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:3000"

# Chain (Base L2)
CHAIN_RPC_URL="https://mainnet.base.org"
CHAIN_ID=8453

# Game Oracle Wallet (backend signs game results)
ORACLE_PRIVATE_KEY=""

# Contract Addresses (deployed later)
BALLERS_TOKEN_ADDRESS=""
NFT_STAKING_ADDRESS=""
TOKEN_STAKING_ADDRESS=""
SEASON_MANAGER_ADDRESS=""
GOVERNANCE_VOTING_ADDRESS=""
PREDICTION_MARKET_ADDRESS=""
BOOST_MANAGER_ADDRESS=""
TREASURY_ADDRESS=""

# X/Twitter API (Phase 5)
TWITTER_API_KEY=""
TWITTER_API_SECRET=""
TWITTER_ACCESS_TOKEN=""
TWITTER_ACCESS_SECRET=""
TWITTER_BEARER_TOKEN=""

# AI Sportscaster (Phase 4)
OPENAI_API_KEY=""
ELEVENLABS_API_KEY=""

# Google Cloud
GCP_PROJECT_ID=""
